# ===================================================
# AI DOCUMENT INTELLIGENCE & WORKFLOW PLATFORM
# Environment Configuration Template
# ===================================================

# ----------------- SERVER CONFIG ------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ----------------- DATABASE CONFIG ----------------
# Local MongoDB instance or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/docintel_platform

# ----------------- SECURITY & AUTH ----------------
JWT_SECRET=super_secret_jwt_key_docintel_enterprise_2026
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ----------------- AI SERVICE CONFIG --------------
# Options: 'gemini' | 'openai' | 'demo'
# If an API key is not supplied, the platform automatically runs in 'demo' mode
# with transparent tagging of demo analysis.
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----------------- STORAGE CONFIG -----------------
# Options: 'local' | 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional AWS S3 Configuration (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ----------------- NEXT.JS CLIENT CONFIG ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
